# One shared password per org, as a JSON object. Each org gets its own
# password so access can be granted and revoked per org: remove an org or
# change its password here and that org is signed out on its next request.
# Passwords must be unique across orgs.
# Leave unset locally to run the site open; production fails closed (503)
# if it is unset or malformed.
DOCS_PASSWORDS={"acme":"change-me-acme","globex":"change-me-globex"}

# Secret used to sign the session cookie. At least 32 characters, or the gate
# fails closed. Generate one with:
#   openssl rand -base64 48
DOCS_AUTH_SECRET=
